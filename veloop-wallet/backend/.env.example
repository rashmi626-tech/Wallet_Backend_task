PORT=5000
MONGO_URI=
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
PAYMENT_WEBHOOK_SECRET=replace-with-a-different-random-secret-at-least-32-characters

# Local default sign-in credentials used by the dev app for quick access.
DEFAULT_NAME=Veloop Admin
DEFAULT_EMAIL=admin@veloopwallet.com
DEFAULT_PASSWORD=Veloop@123

# Used only by the local administrator provisioning script; never used by public auth routes.
ADMIN_NAME=Local Administrator
ADMIN_EMAIL=admin@veloop.test
ADMIN_PASSWORD=replace-with-a-unique-local-password-of-12-chars

# Used only by the local demo seeding script.
DEMO_USER_PASSWORD=replace-with-a-unique-demo-password-of-12-chars

# Optional wallet limits (USD cents).
MAX_WALLET_BALANCE_CENTS=500000
MAX_WITHDRAWAL_AMOUNT_CENTS=250000
FIXED_PAYOUT_AMOUNT_CENTS=50000